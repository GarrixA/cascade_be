{
  "name": "imsys_be",
  "version": "1.0.0",
  "description": "IMSys Serverside",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --require dotenv/config src/index.ts",
    "build": "tsc",
    "start": "node --require dotenv/config dist/index.js",
    "migrate": "npx sequelize-cli db:migrate",
    "migrate:reset": "npx sequelize-cli db:migrate:undo:all && npm run migrate && npm run seed",
    "migrate:down": "npx sequelize-cli db:migrate:undo:all",
    "migrate:undo": "npx sequelize-cli db:migrate:undo",
    "seed": "npx sequelize-cli db:seed:all",
    "seed:undo": "npx sequelize-cli db:seed:undo:all",
    "db:reset": "psql -U postgres -d cascade_dev_db_ -c \"DROP SCHEMA public CASCADE; CREATE SCHEMA public;\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express-session": "^1.18.1",
    "@types/node": "^22.5.0",
    "@types/nodemailer": "^6.4.17",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/randomatic": "^3.1.5",
    "bcrypt": "^5.1.1",
    "cloudinary": "^2.5.0",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.0.0",
    "express-session": "^1.18.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.3",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "randomatic": "^3.1.1",
    "sequelize": "^6.37.3",
    "typescript": "^5.5.4",
    "uuidv4": "^6.2.13"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "5",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.12",
    "@types/node-fetch": "^2.6.13",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.7",
    "node-fetch": "^3.3.2",
    "nodemon": "^3.1.4",
